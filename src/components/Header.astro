---
/**
 * 站点头部 —— 品牌、主导航、主题切换、移动端抽屉。
 * 导航数据来自 src/config.ts，全站只需维护一处。
 */
import { nav, site } from '../config';

const currentPath = Astro.url.pathname;

/** 当前路径是否命中该导航项（含子路由，如 /study/xxx/） */
function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label={`${site.title} 首页`}>
      <span class="brand-mark" aria-hidden="true">YZ</span>
      <span>{site.title}</span>
    </a>

    <nav class="nav" id="site-nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            class="nav-item"
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-tools">
      <button
        class="icon-btn"
        type="button"
        data-theme-toggle
        aria-label="切换深色 / 浅色主题"
        aria-pressed="false"
        title="切换深色 / 浅色主题"
      >
        <svg
          class="icon-sun"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4.2"></circle>
          <path
            d="M12 2.6v2.2M12 19.2v2.2M4.4 4.4l1.6 1.6M18 18l1.6 1.6M2.6 12h2.2M19.2 12h2.2M4.4 19.6L6 18M18 6l1.6-1.6"
          ></path>
        </svg>
        <svg
          class="icon-moon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.2 8.2 0 1 0 10.2 10.2Z"></path>
        </svg>
      </button>

      <button
        class="icon-btn menu-btn"
        type="button"
        data-menu-toggle
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="展开导航菜单"
        title="导航菜单"
      >
        <svg
          class="icon-menu"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3.5 7h17M3.5 12h17M3.5 17h17"></path>
        </svg>
        <svg
          class="icon-close"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const navEl = document.getElementById('site-nav');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  if (navEl && menuBtn) {
    const setOpen = (open: boolean) => {
      navEl.dataset.open = String(open);
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', open ? '收起导航菜单' : '展开导航菜单');
    };

    menuBtn.addEventListener('click', () => {
      setOpen(navEl.dataset.open !== 'true');
    });

    // 点击导航项后收起抽屉
    navEl.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && navEl.dataset.open === 'true') {
        setOpen(false);
        menuBtn.focus();
      }
    });

    // 回到桌面宽度时重置抽屉状态，避免残留内联布局
    const desktop = window.matchMedia('(min-width: 821px)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
