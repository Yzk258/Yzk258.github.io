---
import type { CollectionEntry } from "astro:content";
import { getReadingMinutes } from "@/utils/readingTime";
import { slugify } from "@/utils/slug";
import { useTranslations } from "@/i18n";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
  /** 显示阅读时长 */
  showReadingTime?: boolean;
  /** 显示标签 */
  showTags?: boolean;
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  showReadingTime = true,
  showTags = false,
  id,
  data,
  body = "",
} = Astro.props;

const { title, description, tags, ...rest } = data;
const href = `/posts/${slugify(id)}/`;
const minutes = getReadingMinutes(body ?? "");
const t = useTranslations();
---

<li class="border-border border-b py-6 last:border-b-0">
  <a
    href={href}
    class="text-accent focus-outline inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline"
  >
    <Heading>{title}</Heading>
  </a>

  <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
    <Datetime {...rest} />
    {
      showReadingTime && (
        <span class="text-muted-foreground text-sm">
          {t.posts.readingTime} {minutes} {t.posts.minutes}
        </span>
      )
    }
  </div>

  <p class="mt-2">{description}</p>

  {
    showTags && tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {tags.map(tag => (
          <li>
            <a
              href={`/tags/${slugify(tag)}/`}
              class="bg-muted text-muted-foreground focus-outline hover:bg-accent hover:text-accent-foreground rounded px-2 py-0.5 text-xs no-underline transition-colors"
            >
              {tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</li>
