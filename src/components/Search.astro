---
/**
 * 站内搜索
 *
 * 结构与样式来自本站旧版的 search.js，逻辑已迁到 src/scripts/search.ts。
 * 索引数据由 src/data/search.ts 派生，随页面一起静态输出，不需要网络请求。
 */
import { searchIndexJson } from '../data/search';
---

<div class="search" data-search data-open="false" data-has-text="false">
  <button
    class="icon-btn search-trigger"
    type="button"
    data-search-trigger
    aria-label="打开站内搜索"
    title="站内搜索（Ctrl / ⌘ + K）"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="6.5"></circle>
      <path d="M16 16l4.5 4.5"></path>
    </svg>
  </button>

  <div class="search-field">
    <svg
      class="search-icon"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="6.5"></circle>
      <path d="M16 16l4.5 4.5"></path>
    </svg>

    <input
      type="search"
      class="search-input"
      id="search-input"
      data-search-input
      placeholder="搜索课程与页面…"
      autocomplete="off"
      spellcheck="false"
      aria-label="站内搜索"
      aria-controls="search-results"
      aria-expanded="false"
      role="combobox"
      aria-autocomplete="list"
    />

    <button
      class="search-clear"
      type="button"
      data-search-clear
      aria-label="清空搜索"
      hidden
    >
      ×
    </button>
    <kbd class="search-kbd" aria-hidden="true" data-search-kbd>Ctrl K</kbd>
  </div>

  <div class="search-results" id="search-results" data-search-panel>
    <div class="msd-scroll" role="listbox" aria-label="搜索结果" data-search-list></div>
    <div class="msd-footer" data-search-footer></div>
  </div>
</div>

<!-- 搜索索引：静态输出，不额外请求接口 -->
<script type="application/json" id="search-index-data" is:inline set:html={searchIndexJson} />

<style>
  .search {
    display: contents;
  }

  /* ---------- 输入区 ---------- */
  .search-field {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 15rem;
    padding-inline: 0.7rem;
    border: var(--border-hairline);
    border-radius: var(--radius-full);
    background: var(--c-surface);
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease),
      width var(--dur) var(--ease);
  }

  .search-field:focus-within {
    width: 19rem;
    border-color: var(--c-accent);
    box-shadow: 0 0 0 3px var(--c-accent-soft);
  }

  .search-icon {
    flex: none;
    color: var(--c-text-dim);
  }

  .search-input {
    width: 100%;
    min-width: 0;
    padding-block: 0.45rem;
    border: none;
    outline: none;
    background: none;
    font-size: 0.875rem;
  }

  .search-input::placeholder {
    color: var(--c-text-dim);
  }

  /* 去掉 Safari 的原生清除按钮，用自定义的 */
  .search-input::-webkit-search-cancel-button {
    appearance: none;
  }

  .search-clear {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: var(--radius-full);
    background: var(--c-bg-soft);
    color: var(--c-text-soft);
    font-size: 0.875rem;
    line-height: 1;
  }

  .search-clear:hover {
    background: var(--c-accent-soft);
    color: var(--c-accent-text);
  }

  .search-kbd {
    flex: none;
    padding: 0.1rem 0.35rem;
    border: var(--border-hairline);
    border-radius: var(--radius-xs);
    background: var(--c-bg-soft);
    color: var(--c-text-dim);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  /* 聚焦或已有输入时隐藏快捷键提示，把空间让给内容 */
  .search:focus-within .search-kbd,
  .search[data-has-text='true'] .search-kbd {
    display: none;
  }

  /* ---------- 结果面板 ---------- */
  .search-results {
    position: fixed;
    top: 5rem;
    left: 1rem;
    z-index: 120;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px) scale(0.985);
    transform-origin: top center;
    border: var(--border-hairline);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    transition: opacity 0.18s var(--ease), transform 0.2s var(--ease), visibility 0.18s;
  }

  .search[data-open='true'] .search-results {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .msd-scroll {
    max-height: min(26rem, 60vh);
    overflow-y: auto;
    padding: 0.375rem;
  }

  .msd-group-label {
    padding: 0.6rem 0.75rem 0.25rem;
    color: var(--c-text-dim);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  :global(.msd-item) {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--c-text);
    font-size: 0.875rem;
    text-decoration: none;
    animation: msdIn 0.22s var(--ease) both;
    animation-delay: var(--d, 0ms);
  }

  :global(.msd-item .msd-icon) {
    flex: none;
    width: 1.25rem;
    text-align: center;
  }

  :global(.msd-item .msd-title) {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.msd-item mark) {
    background: transparent;
    color: var(--c-accent-text);
    font-weight: 700;
  }

  :global(.msd-item .msd-enter) {
    flex: none;
    color: var(--c-text-dim);
    font-size: 0.75rem;
    opacity: 0;
    transform: translateX(-4px);
    transition: 0.15s var(--ease);
  }

  :global(.msd-item.active) {
    background: var(--c-accent-soft);
    color: var(--c-accent-text);
    font-weight: 600;
  }

  :global(.msd-item.active .msd-enter) {
    opacity: 1;
    transform: none;
  }

  @keyframes msdIn {
    from {
      opacity: 0;
      transform: translateY(-5px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .msd-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.875rem;
    border-block-start: var(--border-hairline);
    background: var(--c-surface-2);
    color: var(--c-text-dim);
    font-size: 0.6875rem;
  }

  .msd-keys {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    white-space: nowrap;
  }

  :global(.msd-footer kbd) {
    padding: 0.05rem 0.3rem;
    border: var(--border-hairline);
    border-radius: var(--radius-xs);
    background: var(--c-bg-soft);
    color: var(--c-text-soft);
    font-family: var(--font-sans);
    font-size: 0.625rem;
  }

  :global(.msd-empty) {
    padding: 1.5rem 1rem;
    color: var(--c-text-soft);
    font-size: 0.8125rem;
    line-height: 1.8;
    text-align: center;
  }

  :global(.msd-empty b) {
    color: var(--c-text);
  }

  :global(.msd-empty-icon) {
    display: block;
    margin-block-end: 0.5rem;
    font-size: 1.375rem;
  }

  /* ---------- 窄屏：改为图标按钮 + 全宽面板 ---------- */
  .search-trigger {
    display: none;
  }

  @media (max-width: 820px) {
    .search-trigger {
      display: grid;
    }

    .search-field {
      position: fixed;
      top: 0.75rem;
      left: var(--gutter);
      right: var(--gutter);
      z-index: 130;
      width: auto;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.5rem);
      transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease),
        visibility var(--dur);
    }

    .search-field:focus-within {
      width: auto;
    }

    .search[data-open='true'] .search-field {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    /* 面板打开时不再需要快捷键提示 */
    .search-kbd {
      display: none;
    }

    .search-results {
      top: 4.25rem;
    }

    .msd-keys {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-results,
    :global(.msd-item) {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  import { mountSearch } from '../scripts/search';
  mountSearch();
</script>
