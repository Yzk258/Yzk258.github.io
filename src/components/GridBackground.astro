<canvas class="particle-background" aria-hidden="true"></canvas>

<script>
  let cleanup: (() => void) | undefined;
  const initializeGridBackground = () => {
    cleanup?.();
    const canvas = document.querySelector<HTMLCanvasElement>(".particle-background");

    if (canvas && !canvas.dataset.bound) {
      canvas.dataset.bound = "true";
      const context = canvas.getContext("2d");
      if (!context) throw new Error("Canvas 2D context is unavailable");

      type GridNode = {
        ox: number;
        oy: number;
        x: number;
        y: number;
        vx: number;
        vy: number;
        glow: number;
      };

      const nodes: GridNode[] = [];
      const pointer = { x: 0, y: 0, active: false };
      const impulse = { x: 0, y: 0, strength: 0 };
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      const INFLUENCE = 200;
      const MAX_PULL = 20;
      const STIFFNESS = 0.0018;
      const DAMPING = 0.92;
      const BREATH_AMPLITUDE = 0.9;
      const BREATH_SPEED = 0.0025;
      const IMPULSE_RADIUS = 300;
      const IMPULSE_STRENGTH = 120;
      const IMPULSE_DECAY = 0.968;

      let width = 0;
      let height = 0;
      let pixelRatio = 1;
      let cols = 0;
      let rows = 0;
      let spacing = 54;
      let time = 0;
      let animationFrame = 0;

      const colorFromToken = (token: string, fallback: string) => {
        const value = getComputedStyle(document.documentElement).getPropertyValue(token).trim();
        return value || fallback;
      };

      const buildNodes = () => {
        spacing = width < 640 ? 58 : 74;
        cols = Math.ceil(width / spacing) + 1;
        rows = Math.ceil(height / spacing) + 1;
        nodes.length = 0;
        for (let row = 0; row < rows; row += 1) {
          for (let col = 0; col < cols; col += 1) {
            const ox = col * spacing;
            const oy = row * spacing;
            nodes.push({ ox, oy, x: ox, y: oy, vx: 0, vy: 0, glow: 0 });
          }
        }
      };

      const resize = () => {
        width = window.innerWidth;
        height = window.innerHeight;
        pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = width * pixelRatio;
        canvas.height = height * pixelRatio;
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        buildNodes();
        start();
      };

      const update = () => {
        time += BREATH_SPEED;
        for (const node of nodes) {
          const breathX =
            Math.sin(time + node.ox * 0.014 + node.oy * 0.007) * BREATH_AMPLITUDE;
          const breathY =
            Math.cos(time * 0.9 + node.oy * 0.014 - node.ox * 0.006) * BREATH_AMPLITUDE;
          let targetX = node.ox + breathX;
          let targetY = node.oy + breathY;
          let glow = 0;

          if (pointer.active) {
            const dx = node.ox - pointer.x;
            const dy = node.oy - pointer.y;
            const distance = Math.hypot(dx, dy);
            if (distance < INFLUENCE) {
              const strength = 1 - distance / INFLUENCE;
              const amount = MAX_PULL * strength;
              if (distance > 0.001) {
                targetX += (dx / distance) * amount;
                targetY += (dy / distance) * amount;
              }
              glow = strength;
            }
          }

          if (impulse.strength > 0.2) {
            const dx = node.ox - impulse.x;
            const dy = node.oy - impulse.y;
            const distance = Math.hypot(dx, dy);
            if (distance < IMPULSE_RADIUS && distance > 0.001) {
              const strength = (1 - distance / IMPULSE_RADIUS) * impulse.strength;
              targetX += (dx / distance) * strength;
              targetY += (dy / distance) * strength;
            }
          }

          node.vx = (node.vx + (targetX - node.x) * STIFFNESS) * DAMPING;
          node.vy = (node.vy + (targetY - node.y) * STIFFNESS) * DAMPING;
          node.x += node.vx;
          node.y += node.vy;
          node.glow += (glow - node.glow) * 0.16;
        }

        impulse.strength = impulse.strength > 0.2 ? impulse.strength * IMPULSE_DECAY : 0;
      };

      const draw = () => {
        context.clearRect(0, 0, width, height);
        const foreground = colorFromToken("--foreground", "#cdd6f4");

        const baseAlpha = 0.07;
        const highlightAlpha = 0.36;
        const LEVELS = 10;
        const paths: Path2D[] = [];
        for (let level = 0; level <= LEVELS; level += 1) paths.push(new Path2D());

        const addSegment = (a: GridNode, b: GridNode) => {
          let proximity = 0;
          if (pointer.active) {
            const midX = (a.x + b.x) / 2;
            const midY = (a.y + b.y) / 2;
            const distance = Math.hypot(pointer.x - midX, pointer.y - midY);
            if (distance < INFLUENCE) proximity = 1 - distance / INFLUENCE;
          }
          const bucket = Math.max(0, Math.min(LEVELS, Math.round(proximity * LEVELS)));
          paths[bucket].moveTo(a.x, a.y);
          paths[bucket].lineTo(b.x, b.y);
        };

        for (let row = 0; row < rows; row += 1) {
          const base = row * cols;
          for (let col = 0; col < cols; col += 1) {
            const node = nodes[base + col];
            if (col < cols - 1) addSegment(node, nodes[base + col + 1]);
            if (row < rows - 1) addSegment(node, nodes[base + cols + col]);
          }
        }

        context.lineWidth = 1.6;
        for (let bucket = 0; bucket <= LEVELS; bucket += 1) {
          const alphaValue = baseAlpha + (highlightAlpha - baseAlpha) * (bucket / LEVELS);
          const alpha = Math.round(alphaValue * 255)
            .toString(16)
            .padStart(2, "0");
          context.strokeStyle = `${foreground}${alpha}`;
          context.stroke(paths[bucket]);
        }

        for (const node of nodes) {
          const radius = 1.8 + node.glow * 3;
          const alpha = Math.round((0.13 + node.glow * 0.72) * 255)
            .toString(16)
            .padStart(2, "0");
          context.beginPath();
          context.arc(node.x, node.y, radius, 0, Math.PI * 2);
          context.fillStyle = `${foreground}${alpha}`;
          context.fill();
        }
      };

      const loop = () => {
        update();
        draw();
        animationFrame = requestAnimationFrame(loop);
      };

      const start = () => {
        cancelAnimationFrame(animationFrame);
        if (reducedMotion.matches) {
          for (const node of nodes) {
            node.x = node.ox;
            node.y = node.oy;
            node.vx = 0;
            node.vy = 0;
            node.glow = 0;
          }
          draw();
        } else {
          loop();
        }
      };

      const controller = new AbortController();
      const options = { passive: true, signal: controller.signal };
      window.addEventListener("resize", resize, options);
      window.addEventListener("pointermove", (event) => {
        if (event.pointerType !== "mouse") return;
        pointer.x = event.clientX;
        pointer.y = event.clientY;
        pointer.active = true;
      }, options);
      const resetPointer = () => { pointer.active = false; };
      document.addEventListener("pointerleave", resetPointer, options);
      window.addEventListener("blur", resetPointer, options);
      window.addEventListener("click", (event) => {
        if (event.detail === 0 || reducedMotion.matches) return;
        impulse.x = event.clientX;
        impulse.y = event.clientY;
        impulse.strength = IMPULSE_STRENGTH;
      }, options);
      reducedMotion.addEventListener("change", start, options);

      cleanup = () => {
        controller.abort();
        cancelAnimationFrame(animationFrame);
        delete canvas.dataset.bound;
        cleanup = undefined;
      };

      resize();
    }
  };

  initializeGridBackground();
  document.addEventListener("astro:page-load", initializeGridBackground);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>

<style>
  .particle-background {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: 0.68;
    mask-image: linear-gradient(to bottom, black 0%, black 72%, transparent 100%);
  }

  @media (max-width: 640px), (prefers-reduced-motion: reduce) {
    .particle-background {
      opacity: 0.46;
    }
  }
</style>
