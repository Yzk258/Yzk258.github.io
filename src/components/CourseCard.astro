---
import type { Course } from '../data/study';

interface Props {
  course: Course;
}

const { course } = Astro.props;
const hasResources = (course.resources ?? 0) > 0;
---

<article class="card card-course" id={course.id} data-reveal>
  <h3 class="card-title">{course.name}</h3>

  {
    course.teacher && (
      <p class="course-teacher">{course.teacher} 老师</p>
    )
  }

  {
    course.tags && course.tags.length > 0 && (
      <div class="tag-row course-tags">
        {course.tags.map((tag) => (
          <span class="tag tag-neutral">{tag}</span>
        ))}
      </div>
    )
  }

  <p class="course-status">
    {
      hasResources ? (
        <span class="tag">{course.resources} 份资料</span>
      ) : (
        <span class="course-pending">资料待补充</span>
      )
    }
  </p>
</article>

<style>
  .card-course {
    display: flex;
    flex-direction: column;
  }

  .course-teacher {
    color: var(--c-text-soft);
    font-size: 0.875rem;
  }

  .course-tags {
    margin-block-start: 0.75rem;
  }

  .course-status {
    margin-block-start: auto;
    padding-block-start: 1rem;
  }

  .course-pending {
    color: var(--c-text-dim);
    font-size: 0.8125rem;
  }

  /* 锚点跳转时高亮目标课程，方便从外部链接直达 */
  .card-course:target {
    border-color: var(--c-accent);
    box-shadow: var(--shadow-md);
  }
</style>
