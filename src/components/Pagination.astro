---
/**
 * 分页导航。文章列表页与各标签页共用。
 *
 * 只有一页时整块不渲染 —— 否则会多出一个「1 / 1」的无效控件。
 */
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { useTranslations } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;
const t = useTranslations();

const linkClass =
  "focus-outline hover:text-accent inline-flex items-center gap-1 px-3 py-1.5 no-underline";
---

{
  page.lastPage > 1 && (
    <nav
      class="border-border mt-8 flex items-center justify-center gap-2 border-t pt-6 pb-2"
      aria-label={t.a11y.pagination}
    >
      {page.url.prev ? (
        <a href={page.url.prev} class={linkClass} rel="prev">
          <IconArrowLeft class="inline-block size-4" />
          {t.pagination.prev}
        </a>
      ) : (
        <span class={`${linkClass} text-muted-foreground opacity-50`} aria-hidden="true">
          <IconArrowLeft class="inline-block size-4" />
          {t.pagination.prev}
        </span>
      )}

      <span class="text-muted-foreground px-1 text-sm tabular-nums">
        {page.currentPage} / {page.lastPage}
      </span>

      {page.url.next ? (
        <a href={page.url.next} class={linkClass} rel="next">
          {t.pagination.next}
          <IconArrowRight class="inline-block size-4" />
        </a>
      ) : (
        <span class={`${linkClass} text-muted-foreground opacity-50`} aria-hidden="true">
          {t.pagination.next}
          <IconArrowRight class="inline-block size-4" />
        </span>
      )}
    </nav>
  )
}
