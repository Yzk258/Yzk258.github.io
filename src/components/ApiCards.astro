---
/**
 * 三个调用公开接口的小卡片：GitHub Zen / 随机图片 / 随机用户。
 *
 * 特性（沿用此前实现的约定）：
 *   - 每张卡片首次接近视口才发请求，避免白等
 *   - 6 秒超时，失败走兜底文案，不让页面卡住
 *   - 连点用自增序号保护，只采用最后一次请求的结果
 *   - 断网时直接提示，不做无效请求
 *   - 整卡可键盘操作（Enter / Space），带 aria-label
 */
---

<section class="api-grid mt-6" aria-label="第三方接口小卡片">
  <!-- GitHub Zen -->
  <div
    class="api-card"
    role="button"
    tabindex="0"
    data-api="zen"
    aria-label="GitHub Zen，点击换一句"
    title="点我换一句"
  >
    <p class="api-text" data-api-text>正在连接 GitHub…</p>
    <p class="api-from" data-api-from-label>GitHub Zen</p>
  </div>

  <!-- 随机图片 -->
  <div
    class="api-card api-card--wide"
    role="button"
    tabindex="0"
    data-api="photo"
    aria-label="随机图片，点击换一张"
    title="点我换一张图片"
  >
    <div class="api-frame">
      <img
        class="api-img"
        data-api-img
        alt=""
        width="640"
        height="420"
        loading="lazy"
        decoding="async"
      />
        <p class="api-placeholder" data-api-placeholder>正在找一张图片…</p>
    </div>
    <p class="api-from" data-api-from-photo>Picsum · 随机图片</p>
  </div>

  <!-- 随机用户 -->
  <div
    class="api-card"
    role="button"
    tabindex="0"
    data-api="user"
    aria-label="随机用户，点击换一个"
    title="点我换一个用户"
  >
    <p class="api-text" data-api-text>正在随机抽取用户…</p>
    <p class="api-from" data-api-from-label>Random User</p>
  </div>
</section>

<style>
  .api-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .api-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .api-card--wide {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  .api-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    padding: 1rem;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .api-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .api-card:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }

  .api-text {
    margin: 0;
    flex: 1;
    font-size: 0.95rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .api-from {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  /* 随机图片区域 */
  .api-frame {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 8rem;
    overflow: hidden;
    border-radius: 0.25rem;
    background: var(--muted);
  }

  .api-card--wide .api-frame {
    min-height: 12rem;
  }

  .api-img {
    display: none;
    width: 100%;
    height: 100%;
    max-height: 18rem;
    object-fit: cover;
  }

  .api-img[data-loaded='true'] {
    display: block;
  }

  .api-img[data-loaded='true'] + .api-placeholder {
    display: none;
  }

  .api-placeholder {
    margin: 0;
    padding: 1rem;
    color: var(--muted-foreground);
    font-size: 0.85rem;
    text-align: center;
  }

  /* 加载中 / 失败的状态文字 */
  .api-card[data-state='error'] .api-text,
  .api-card[data-state='offline'] .api-text {
    color: var(--muted-foreground);
  }

  @media (prefers-reduced-motion: reduce) {
    .api-card {
      transition: none;
    }

    .api-card:hover {
      transform: none;
    }
  }
</style>

<script>
  type Kind = 'zen' | 'photo' | 'user';

  const TIMEOUT_MS = 6000;
  const IMAGE_TIMEOUT_MS = 3500;

  /** 请求序号：连点时只采用最后一次的结果 */
  const seqMap = new Map<Kind, number>();

  function nextSeq(kind: Kind): number {
    const next = (seqMap.get(kind) ?? 0) + 1;
    seqMap.set(kind, next);
    return next;
  }

  function isCurrent(kind: Kind, seq: number): boolean {
    return seqMap.get(kind) === seq;
  }

  /** 带超时的 fetch —— 超时后主动 abort，避免请求悬挂 */
  async function fetchJson<T>(url: string): Promise<T> {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);
    try {
      const res = await fetch(url, { signal: controller.signal });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return (await res.json()) as T;
    } finally {
      clearTimeout(timer);
    }
  }

  async function fetchText(url: string): Promise<string> {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);
    try {
      const res = await fetch(url, { signal: controller.signal });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return await res.text();
    } finally {
      clearTimeout(timer);
    }
  }

  function setText(el: Element | null, text: string) {
    if (el) el.textContent = text;
  }

  /** 一律用 textContent 写入，天然免疫 HTML 注入 */
  async function loadZen(card: HTMLElement, seq: number) {
    const textEl = card.querySelector<HTMLElement>('[data-api-text]');
    const fromEl = card.querySelector<HTMLElement>('[data-api-from-label]');
    if (!textEl || !fromEl) return;

    if (!navigator.onLine) {
      card.dataset.state = 'offline';
      setText(textEl, '离线状态下用不了，联网后再点。');
      return;
    }

    card.dataset.state = 'loading';
    try {
      const data = await fetchText('https://api.github.com/zen');
      if (!isCurrent('zen', seq)) return;
      card.dataset.state = 'ready';
      setText(textEl, `「${data}」`);
      setText(fromEl, '—— GitHub Zen');
    } catch {
      if (!isCurrent('zen', seq)) return;
      card.dataset.state = 'error';
      setText(textEl, 'GitHub 暂时没有回应，点一下重试。');
    }
  }

  async function loadPhoto(card: HTMLElement, seq: number) {
    const img = card.querySelector<HTMLImageElement>('[data-api-img]');
    const placeholder = card.querySelector<HTMLElement>('[data-api-placeholder]');
    const fromEl = card.querySelector<HTMLElement>('[data-api-from-photo]');
    if (!img || !placeholder) return;

    if (!navigator.onLine) {
      card.dataset.state = 'offline';
      setText(placeholder, '离线状态下加载不了图片，联网后再点。');
      return;
    }

    card.dataset.state = 'loading';
      setText(placeholder, '正在找一张图片…');
    try {
      const imageId = 200 + Math.floor(Math.random() * 80);
      const imageUrls = [
        `https://picsum.photos/id/${imageId}/640/420`,
        `https://picsum.photos/seed/${imageId}-${Date.now()}/640/420`,
      ];

      // 首次连接较慢时自动换一种 Picsum 地址重试，不要求用户再次点击。
      let loaded = false;
      for (const imageUrl of imageUrls) {
        try {
          await new Promise<void>((resolve, reject) => {
            const timeout = window.setTimeout(() => reject(new Error('image timeout')), IMAGE_TIMEOUT_MS);
            img.onload = () => {
              window.clearTimeout(timeout);
              resolve();
            };
            img.onerror = () => {
              window.clearTimeout(timeout);
              reject(new Error('image failed'));
            };
            img.src = imageUrl;
          });
          loaded = true;
          break;
        } catch {
          // 尝试下一个地址
        }
      }
      if (!loaded) throw new Error('image unavailable');
      if (!isCurrent('photo', seq)) return;

      card.dataset.state = 'ready';
      img.dataset.loaded = 'true';
      setText(fromEl, 'Picsum · 随机图片');
    } catch {
      if (!isCurrent('photo', seq)) return;
      card.dataset.state = 'error';
      // 外部图片服务不可用时，至少显示站点自己的本地备用图。
      img.onerror = null;
      img.src = '/default-og.jpg';
      img.dataset.loaded = 'true';
      setText(fromEl, '本站备用图');
    }
  }

  async function loadUser(card: HTMLElement, seq: number) {
    const textEl = card.querySelector<HTMLElement>('[data-api-text]');
    const fromEl = card.querySelector<HTMLElement>('[data-api-from-label]');
    if (!textEl || !fromEl) return;

    if (!navigator.onLine) {
      card.dataset.state = 'offline';
      setText(textEl, '离线状态下抽不了用户，联网后再点。');
      return;
    }

    card.dataset.state = 'loading';
    try {
      const data = await fetchJson<{ results: Array<{ name: { first: string; last: string }; location: { country: string } }> }>(
        'https://randomuser.me/api/?inc=name,location&noinfo'
      );
      if (!isCurrent('user', seq)) return;
      card.dataset.state = 'ready';
      const user = data.results?.[0];
      if (!user) throw new Error('empty payload');
      setText(textEl, `${user.name.first} ${user.name.last}`);
      setText(fromEl, `Random User · ${user.location.country}`);
    } catch {
      if (!isCurrent('user', seq)) return;
      card.dataset.state = 'error';
      setText(textEl, '随机用户接口暂时离线，点一下重试。');
    }
  }

  const loaders: Record<
    Kind,
    (card: HTMLElement, seq: number) => Promise<void>
  > = {
    zen: loadZen,
    photo: loadPhoto,
    user: loadUser,
  };

  function refresh(card: HTMLElement) {
    const kind = card.dataset.api as Kind | undefined;
    if (!kind || !loaders[kind]) return;
    void loaders[kind](card, nextSeq(kind));
  }

  function initCard(card: HTMLElement) {
    // 启用客户端路由后 astro:after-swap 会再次触发，避免重复绑定监听
    if (card.dataset.bound === 'true') return;
    card.dataset.bound = 'true';
    card.addEventListener('click', () => refresh(card));
    card.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        refresh(card);
      }
    });
  }

  function init() {
    const cards = document.querySelectorAll<HTMLElement>('[data-api]');
    if (cards.length === 0) return;

    cards.forEach(initCard);

    // 真正进入视口时才发首次请求（首屏可见的话会立即触发）
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        entries => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            refresh(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '0px' }
      );
      cards.forEach(card => observer.observe(card));
    } else {
      cards.forEach(card => refresh(card));
    }
  }

  init();
  document.addEventListener("astro:after-swap", init);
</script>
