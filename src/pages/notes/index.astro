---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { updates } from '../../data/updates';

const sorted = updates.slice().sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout title="更新日志" description="这个站点以及站内内容的变更记录。">
  <PageHeader
    eyebrow="Changelog"
    title="更新日志"
    description="记录站点结构、样式与内容的变化。与其说是给别人看，不如说是给自己留个存档。"
  />

  {
    sorted.length > 0 ? (
      <ol class="timeline">
        {sorted.map((update) => (
          <li class="timeline-item" data-reveal>
            <div class="timeline-marker" aria-hidden="true" />
            <article class="card timeline-card">
              <header class="timeline-head">
                <time class="timeline-date" datetime={update.date}>
                  {update.date}
                </time>
                <h2 class="card-title">{update.title}</h2>
              </header>
              <ul class="timeline-items">
                {update.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              {update.tags && update.tags.length > 0 && (
                <div class="tag-row timeline-tags">
                  {update.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </article>
          </li>
        ))}
      </ol>
    ) : (
      <div class="notice">
        <span aria-hidden="true">📝</span>
        <p>
          <strong>还没有记录。</strong>
          在 <code>src/data/updates.ts</code> 里按日期倒序添加即可。
        </p>
      </div>
    )
  }
</BaseLayout>

<style>
  .timeline {
    display: grid;
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .timeline-item {
    position: relative;
    padding-inline-start: 1.75rem;
    border-inline-start: 2px solid var(--c-border);
  }

  .timeline-item:last-child {
    border-inline-start-color: transparent;
  }

  .timeline-marker {
    position: absolute;
    inset-inline-start: -0.5rem;
    inset-block-start: 1.9rem;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: var(--radius-full);
    background: var(--c-accent);
    box-shadow: 0 0 0 4px var(--c-bg);
  }

  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin-block-end: 0.5rem;
  }

  .timeline-date {
    color: var(--c-text-dim);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .timeline-items {
    color: var(--c-text-soft);
    font-size: 0.9375rem;
  }

  .timeline-items li + li {
    margin-block-start: 0.35rem;
  }

  .timeline-tags {
    margin-block-start: 1rem;
  }
</style>
