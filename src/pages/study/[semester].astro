---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CourseCard from '../../components/CourseCard.astro';
import { coursesOf, semesters } from '../../data/study';

export function getStaticPaths() {
  return semesters.map((semester) => ({
    params: { semester: semester.id },
    props: { semester },
  }));
}

const { semester } = Astro.props;
const list = coursesOf(semester.id);

// 找出相邻学期，方便前后翻页
const index = semesters.findIndex((item) => item.id === semester.id);
const prev = index > 0 ? semesters[index - 1] : undefined;
const next = index < semesters.length - 1 ? semesters[index + 1] : undefined;
---

<BaseLayout
  title={semester.label}
  description={`${semester.label}的课程列表与学习资料。`}
>
  <p class="crumb">
    <a href="/study/">← 学习资料库</a>
  </p>

  <PageHeader
    eyebrow="Study"
    title={semester.label}
    description={`该学期共 ${list.length} 门课程。${semester.note ? `（${semester.note}）` : ''}`}
  />

  {
    list.length > 0 ? (
      <div class="course-grid">
        {list.map((course) => (
          <CourseCard course={course} />
        ))}
      </div>
    ) : (
      <div class="notice">
        <span aria-hidden="true">🗂️</span>
        <p>
          <strong>这个学期还没有登记课程。</strong>
          在 <code>src/data/study.ts</code> 的 <code>courses</code> 里添加即可出现在这里。
        </p>
      </div>
    )
  }

  <nav class="pager" aria-label="学期导航">
    {
      prev ? (
        <a class="btn" href={`/study/${prev.id}/`}>← {prev.label}</a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a class="btn" href={`/study/${next.id}/`}>{next.label} →</a>
      ) : (
        <span />
      )
    }
  </nav>
</BaseLayout>

<style>
  .crumb {
    margin-block-end: 1.5rem;
    font-size: 0.875rem;
  }

  .crumb a {
    text-decoration: none;
  }

  .crumb a:hover {
    text-decoration: underline;
  }

  .course-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: var(--section-gap);
    padding-block-start: 1.75rem;
    border-block-start: var(--border-hairline);
  }
</style>
