---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import ApiCards from "@/components/ApiCards.astro";
import { hubs } from "@/data/hubs";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;

const t = useTranslations();

const primaryHub = hubs.find(hub => hub.primary);
const secondaryHubs = hubs.filter(hub => !hub.primary);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout my-1">
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1
        class="my-4 inline-block text-4xl font-bold sm:my-6 sm:text-5xl"
        transition:name="site-title"
      >
        {config.site.title}
      </h1>
      <p>
        这里是 <strong>YZK</strong> 的主页与资源中转站 —— 把散落在各处的入口收在一处。
        最新内容以个人主站为准，GitHub 上是各类代码与本站源码。
      </p>
      {
        primaryHub && (
          <p class="mt-4">
            <a
              href={primaryHub.href}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-accent text-accent-foreground focus-outline inline-block rounded-md px-4 py-2 font-medium no-underline"
            >
              {primaryHub.icon} 前往{primaryHub.title}
              <span aria-hidden="true"> ↗</span>
            </a>
          </p>
        )
      }
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <section id="hubs" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">资源中转</h2>
      <p class="text-muted-foreground mt-2">
        下面每个入口都通向站外或独立板块，点开即可。
      </p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          secondaryHubs.map(hub => (
            <li>
              <a
                href={hub.href}
                target={hub.external ? "_blank" : undefined}
                rel={hub.external ? "noopener noreferrer" : undefined}
                class:list={[
                  "focus-outline border-border hover:border-accent block h-full rounded-lg border p-4 no-underline transition-colors",
                  { "bg-muted/40": hub.primary },
                ]}
              >
                <span class="text-accent text-lg font-medium">
                  <span aria-hidden="true">{hub.icon}</span> {hub.title}
                  {hub.external && <span aria-hidden="true"> ↗</span>}
                </span>
                <span class="text-muted-foreground mt-1 block text-sm">
                  {hub.description}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="playground" class="border-border border-t pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">随便看看</h2>
      <p class="text-muted-foreground mt-2">
        三个调用公开接口的小卡片，点一下换一条。内容来自第三方。
      </p>
      <ApiCards />
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", baseRoot);
    }
  });
</script>
