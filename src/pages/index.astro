---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Avatar from "@/components/Avatar.astro";
import ApiCards from "@/components/ApiCards.astro";
import Card from "@/components/Card.astro";
import ContributionHeatmap from "@/components/ContributionHeatmap.astro";
import { hubs } from "@/data/hubs";
import { getSortedPosts } from "@/utils/posts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;

const t = useTranslations();

// 站内入口统一列在这里：首页索引区块与主导航（Header.astro）各有一份，
// 增删页面时两边都要看一眼。
const siteNav = [
  {
    href: "/posts/",
    title: "文章",
    description: "学习笔记、踩过的坑和一些想法。",
    icon: "📝",
  },
  { href: "/tags/", title: "标签", description: "按主题浏览全部文章。", icon: "🏷️" },
  {
    href: "/archives/",
    title: "归档",
    description: "按时间倒序浏览。",
    icon: "🗂️",
  },
  {
    href: "/about/",
    title: "关于我",
    description: "身份、联系方式与这个站点的由来。",
    icon: "👤",
  },
];

// 首页只放最近几篇；全部文章在 /posts/
const latestPosts = getSortedPosts(await getCollection("posts")).slice(0, 3);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout my-1">
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <p class="text-accent mb-2 text-sm" aria-hidden="true">~ $ whoami</p>
      <div class="my-4 flex items-center gap-4 sm:my-6 sm:gap-5">
        <Avatar size="sm" href={`https://github.com/${config.site.github}`} />
        <h1
          class="terminal-title inline-block text-3xl font-bold sm:text-4xl"
          transition:name="site-title"
        >
          {config.site.title}
        </h1>
      </div>
      <p>
        这里是 <strong>YZK</strong> 的主页 —— 学习笔记、项目记录与资料归档都放在这里，
        日常更新也以本站为准。
      </p>
      {
        /* 座右铭：沿用 hero 顶部 `~ $ whoami` 的「提示符 + 说明」写法。
           `# 座右铭` 是对齐终端注释的装饰，放在 em 之外并标 aria-hidden，
           读屏只会念座右铭本身 */
        config.site.motto && (
          <p class="border-accent mt-5 border-s-2 ps-3 leading-7">
            <span class="text-muted-foreground" aria-hidden="true">
              # 座右铭{" "}
            </span>
            <em>{config.site.motto}</em>
          </p>
        )
      }
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <section id="site-nav" class="border-border border-b pt-12 pb-6">
      <div class="flex items-baseline gap-2">
        <span class="text-accent" aria-hidden="true">##</span>
        <h2 class="text-xl font-semibold tracking-wide">站内导航</h2>
      </div>
      <p class="text-muted-foreground mt-2">本站的几块内容，按目录点进去即可。</p>
      <nav aria-label="站内导航">
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {
            siteNav.map(item => (
              <li>
                <a
                  href={item.href}
                  class="focus-outline border-border hover:border-accent flex h-full flex-col rounded border p-4 no-underline transition-colors"
                >
                  <span class="text-accent text-lg font-medium">
                    <span aria-hidden="true">{item.icon}</span> {item.title}
                  </span>
                  <span class="text-muted-foreground mt-1 text-sm">
                    {item.description}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </section>

    {
      latestPosts.length > 0 && (
        <section id="latest" class="pt-12 pb-6">
          <div class="flex items-baseline justify-between gap-2">
            <div class="flex items-baseline gap-2">
              <span class="text-accent" aria-hidden="true">##</span>
              <h2 class="text-xl font-semibold tracking-wide">
                {t.home.latestPosts}
              </h2>
            </div>
            <a
              href="/posts/"
              class="text-muted-foreground hover:text-accent focus-outline text-sm no-underline"
            >
              {t.home.allPosts} →
            </a>
          </div>
          <ul class="mt-4">
            {latestPosts.map(post => (
              <Card {...post} variant="h3" />
            ))}
          </ul>
        </section>
      )
    }

    <section id="hubs" class="border-border border-t pt-12 pb-6">
      <!-- 井号是对齐终端注释的装饰，放在 h2 之外，避免进入无障碍名称 -->
      <div class="flex items-baseline gap-2">
        <span class="text-accent" aria-hidden="true">##</span>
        <h2 class="text-xl font-semibold tracking-wide">站外入口</h2>
      </div>
      <p class="text-muted-foreground mt-2">
        这两个通向站外：代码与本站源码在 GitHub，想交流直接发邮件。
      </p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          hubs.map(hub => (
            <li>
              <a
                href={hub.href}
                target={hub.external ? "_blank" : undefined}
                rel={hub.external ? "noopener noreferrer" : undefined}
                class="focus-outline border-border hover:border-accent block h-full rounded border p-4 no-underline transition-colors"
              >
                <span class="text-accent text-lg font-medium">
                  <span aria-hidden="true">{hub.icon}</span> {hub.title}
                  {hub.external && <span aria-hidden="true"> ↗</span>}
                </span>
                <span class="text-muted-foreground mt-1 block text-sm">
                  {hub.description}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="playground" class="border-border border-t pt-12 pb-6">
      <div class="flex items-baseline gap-2">
        <span class="text-accent" aria-hidden="true">##</span>
        <h2 class="text-xl font-semibold tracking-wide">随便看看</h2>
      </div>
      <p class="text-muted-foreground mt-2">
        三个调用公开接口的小卡片，点一下换一条。内容来自第三方。
      </p>
      <ApiCards />
    </section>

    <section id="activity" class="border-border border-t pt-12 pb-6">
      <div class="flex items-baseline gap-2">
        <span class="text-accent" aria-hidden="true">##</span>
        <h2 class="text-xl font-semibold tracking-wide">
          {t.activity.title}
        </h2>
      </div>
      <p class="text-muted-foreground mt-2">
        {t.activity.homeDescription}
        <a href="/about/" class="hover:text-accent focus-outline underline">
          {t.activity.homeMore} →
        </a>
      </p>
      <ContributionHeatmap
        username={config.site.github}
        size="lg"
        class="mt-6"
      />
      {/* 窄屏放不下 53 列，热力图可以横向滑动，给一句提示 */}
      <p class="text-muted-foreground mt-2 text-xs sm:hidden">
        {t.activity.scrollHint}
      </p>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* 终端风格：标题末尾一个闪烁的方块光标 */
  .terminal-title::after {
    content: "";
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-inline-start: 0.15em;
    vertical-align: -0.1em;
    background: var(--accent);
    animation: terminal-blink 1.1s steps(2, start) infinite;
  }

  @keyframes terminal-blink {
    to {
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-title::after {
      animation: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", baseRoot);
    }
  });
</script>
