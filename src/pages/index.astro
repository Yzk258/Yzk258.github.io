---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ApiCards from '../components/ApiCards.astro';
import { hubs, site } from '../config';
import { courseCount, coursesOf, semesters } from '../data/study';
import { projects } from '../data/projects';
import { updates } from '../data/updates';

const featured = [
  {
    href: '/study/',
    title: '学习资料库',
    text: '按学期整理的课程笔记、习题与实验报告。',
    meta: `${courseCount} 门课程`,
  },
  {
    href: '/projects/',
    title: '项目库',
    text: '练手项目与课程大作业的记录与归档。',
    meta: projects.length > 0 ? `${projects.length} 个项目` : '待补充',
  },
  {
    href: '/notes/',
    title: '更新日志',
    text: '这个站点本身是怎么一步步搭起来的。',
    meta: `${updates.length} 条记录`,
  },
  {
    href: '/about/',
    title: '关于我',
    text: '一些自我介绍，以及这个站点存在的理由。',
    meta: 'More',
  },
];

const currentSemester = semesters.find((semester) => semester.note) ?? semesters.at(-1)!;
const latest = updates.slice(0, 3);

const stats = [
  { value: String(courseCount), label: '门课程' },
  { value: String(semesters.length), label: '个学期' },
  { value: String(projects.length), label: '个项目' },
];
---

<BaseLayout description={site.description}>
  <!-- Hero -->
  <section class="hero" data-reveal>
    <div class="hero-avatar" aria-hidden="true">YZ</div>

    <div class="hero-body">
      <p class="hero-eyebrow">你好，欢迎来到</p>
      <h1 class="hero-title">
        <span class="gradient-text">YZK</span> 的个人站
      </h1>
      <p class="hero-lead">
        这里既是我的个人主页，也是通往各类资源的<strong>中转站</strong>：<br />
        大学课程的学习资料、折腾过的小项目、建站记录，都收在这里。
      </p>

      <div class="btn-row">
        <a class="btn btn-primary" href="/study/">进入学习资料库</a>
        <a class="btn" href={site.github} target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </div>

      <p class="hero-note">
        当前学期：<strong>{currentSemester.label}</strong>
        <span class="dot" aria-hidden="true">·</span>
        {coursesOf(currentSemester.id).length} 门课程在册
      </p>
    </div>

    <dl class="hero-stats">
      {
        stats.map((stat) => (
          <div class="stat">
            <dt class="stat-label">{stat.label}</dt>
            <dd class="stat-value">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- 资源中转：本站的另一重身份，出口都汇总在这里 -->
  <Section
    title="资源中转"
    description="本站同时作为资源中转站，以下入口可直达各处资源，也可用右上角搜索（Ctrl / ⌘ + K）快速定位任意课程。"
  >
    <div class="grid-auto hub-grid">
      {
        hubs.map((hub) => (
          <a
            class:list={['card', 'card-link', 'hub-card', hub.primary && 'hub-card-primary']}
            href={hub.href}
            target={hub.external ? '_blank' : undefined}
            rel={hub.external ? 'noopener noreferrer' : undefined}
            data-reveal
          >
            <span class="hub-icon" aria-hidden="true">{hub.icon}</span>
            <span class="hub-body">
              <span class="hub-title">
                {hub.title}
                {hub.external && <span class="hub-arrow" aria-hidden="true">↗</span>}
              </span>
              <span class="hub-text">{hub.text}</span>
            </span>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- 快捷入口 -->
  <Section title="从哪儿开始" description="四个入口，按你现在的目的挑一个就好。">
    <div class="grid-auto">
      <a class="card card-link" href="/study/" data-reveal>
        <h3 class="card-title">{featured[0].title}</h3>
        <p class="card-text">{featured[0].text}</p>
        <span class="tag tag-neutral entry-meta">{featured[0].meta}</span>
      </a>
      <a class="card card-link" href="/projects/" data-reveal>
        <h3 class="card-title">{featured[1].title}</h3>
        <p class="card-text">{featured[1].text}</p>
        <span class="tag tag-neutral entry-meta">{featured[1].meta}</span>
      </a>
      <a class="card card-link" href="/notes/" data-reveal>
        <h3 class="card-title">{featured[2].title}</h3>
        <p class="card-text">{featured[2].text}</p>
        <span class="tag tag-neutral entry-meta">{featured[2].meta}</span>
      </a>
      <a class="card card-link" href="/about/" data-reveal>
        <h3 class="card-title">{featured[3].title}</h3>
        <p class="card-text">{featured[3].text}</p>
        <span class="tag tag-neutral entry-meta">{featured[3].meta}</span>
      </a>
    </div>
  </Section>

  <!-- 最近更新 -->
  <Section
    title="最近更新"
    description="站点与内容的变更记录，完整列表见更新日志。"
  >
    <ul class="update-list">
      {
        latest.map((update) => (
          <li class="update-item card" data-reveal>
            <div class="update-head">
              <time datetime={update.date}>{update.date}</time>
              <h3 class="card-title">{update.title}</h3>
            </div>
            <ul class="update-items">
              {update.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {update.tags && (
              <div class="tag-row update-tags">
                {update.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </li>
        ))
      }
    </ul>

    <div class="btn-row section-more">
      <a class="btn" href="/notes/">查看全部更新</a>
    </div>
  </Section>

  <!-- 好玩的 API -->
  <div class="api-block">
    <ApiCards />
  </div>

  <div class="notice" data-reveal>
    <span aria-hidden="true">🛠️</span>
    <p>
      <strong>本站刚换了新框架。</strong>
      旧的页面结构与素材已整理归档，新站内容正在逐步搬进来。
      想看以前的版本，可以翻阅仓库的 git 历史。
    </p>
  </div>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    gap: 2rem;
    padding-block: clamp(1rem, 4vw, 2.5rem) clamp(2.5rem, 6vw, 4rem);
  }

  .hero-avatar {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-xl);
    background: var(--gradient-text);
    color: #ffffff;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    box-shadow: var(--shadow-md);
  }

  html[data-theme='dark'] .hero-avatar {
    color: #04211d;
  }

  .hero-eyebrow {
    color: var(--c-text-dim);
    font-size: 0.9375rem;
  }

  .hero-title {
    margin-block: 0.35rem 1rem;
    font-size: clamp(2.1rem, 6vw, 3.4rem);
    letter-spacing: -0.035em;
  }

  .hero-lead {
    max-width: 46ch;
    color: var(--c-text-soft);
    font-size: clamp(1rem, 1.6vw, 1.125rem);
  }

  .hero .btn-row {
    margin-block-start: 1.75rem;
  }

  .hero-note {
    margin-block-start: 1.25rem;
    color: var(--c-text-dim);
    font-size: 0.875rem;
  }

  .hero-note strong {
    color: var(--c-text-soft);
  }

  .dot {
    margin-inline: 0.4rem;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    padding-block-start: 1.75rem;
    border-block-start: var(--border-hairline);
  }

  .stat-label {
    color: var(--c-text-dim);
    font-size: 0.8125rem;
  }

  .stat-value {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'avatar body'
        'stats stats';
      column-gap: 2.5rem;
      align-items: start;
    }

    .hero-avatar {
      grid-area: avatar;
    }

    .hero-body {
      grid-area: body;
    }

    .hero-stats {
      grid-area: stats;
      justify-content: flex-start;
    }
  }

  /* ---------- 快捷入口 ---------- */
  .entry-meta {
    margin-block-start: 1rem;
  }

  /* ---------- 更新列表 ---------- */
  .update-list {
    display: grid;
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .update-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
  }

  .update-head time {
    color: var(--c-text-dim);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .update-items {
    margin-block-start: 0.75rem;
    color: var(--c-text-soft);
    font-size: 0.9375rem;
  }

  .update-items li + li {
    margin-block-start: 0.35rem;
  }

  .update-tags {
    margin-block-start: 1rem;
  }

  .section-more {
    margin-block-start: 1.75rem;
  }

  /* ---------- 资源中转 ---------- */
  .hub-card {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .hub-icon {
    flex: none;
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .hub-body {
    display: block;
    min-width: 0;
  }

  .hub-title {
    display: block;
    margin-block-end: 0.25rem;
    color: var(--c-text);
    font-size: 1.0625rem;
    font-weight: 650;
  }

  .hub-arrow {
    margin-inline-start: 0.25rem;
    color: var(--c-text-dim);
    font-size: 0.875rem;
  }

  .hub-text {
    display: block;
    color: var(--c-text-soft);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  /* 主站是主要去向，单独高亮 */
  .hub-card-primary {
    border-color: var(--c-card-hover-border);
    background: var(--c-accent-tint);
  }

  .hub-card-primary .hub-title {
    color: var(--c-accent-text);
  }

  /* ---------- API 区块 ---------- */
  .api-block {
    margin-block-start: var(--section-gap);
  }
</style>
