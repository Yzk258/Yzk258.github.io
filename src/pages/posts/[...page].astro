---
/**
 * 文章列表页，带分页。
 *
 * 用 `[...page].astro` + `paginate()` 而不是 `index.astro`：
 * 这是 Astro 生成 /posts/、/posts/page/2/ … 的标准做法。
 * 页大小取 config.posts.perPage，所以那个配置现在真正生效了。
 */
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import { getSortedPosts } from "@/utils/posts";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = getSortedPosts(await getCollection("posts"));
  return paginate(posts, { pageSize: config.posts.perPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const t = useTranslations();
---

<Layout
  title={`${t.posts.title} | ${config.site.title}`}
  description={t.posts.description}
>
  <Header />

  <Main pageTitle={t.posts.title} pageDesc={t.posts.description}>
    {
      page.data.length === 0 ? (
        <p class="text-muted-foreground">{t.posts.empty}</p>
      ) : (
        <ul class="mt-2">
          {page.data.map(post => (
            <Card {...post} showTags />
          ))}
        </ul>
      )
    }
  </Main>

  <Pagination {page} />

  <Footer />
</Layout>
