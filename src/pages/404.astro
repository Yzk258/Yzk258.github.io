---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="这个地址没有对应的页面。">
  <div class="notfound">
    <p class="code gradient-text">404</p>
    <h1 class="title">这个页面不存在</h1>
    <p class="desc">
      链接可能已经失效，或者地址输错了。旧版站点的一些地址在重构后不再使用。
    </p>
    <div class="btn-row actions">
      <a class="btn btn-primary" href="/">回到首页</a>
      <a class="btn" href="/study/">学习资料库</a>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding-block: clamp(2rem, 10vw, 6rem);
    text-align: center;
  }

  .code {
    font-size: clamp(4rem, 18vw, 8rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .title {
    font-size: clamp(1.4rem, 3.5vw, 2rem);
  }

  .desc {
    max-width: 44ch;
    color: var(--c-text-soft);
  }

  .actions {
    justify-content: center;
    margin-block-start: 1rem;
  }
</style>
