---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { site } from '../../config';

const facts = [
  { label: '身份', value: '本科在读 · 理工科' },
  { label: '常驻', value: '北京' },
  { label: '在学', value: '大二下：量子力学、数据结构、计算机网络……' },
  { label: '工具', value: 'Python / C++ · 一点 Web · 什么都会一点' },
];

const contact = [
  { label: '邮箱', value: site.email, href: `mailto:${site.email}` },
  { label: 'GitHub', value: '@Yzk258', href: site.github },
];
---

<BaseLayout
  title="关于我"
  description="YZK 的自我介绍，以及这个站点为什么存在。"
>
  <PageHeader
    eyebrow="About"
    title="关于我"
    description="一个还在读书、喜欢到处折腾的人，以及一个为存放这些折腾而建的站。"
  />

  <div class="about-grid">
    <section class="card about-intro" data-reveal>
      <div class="about-identity">
        <div class="about-avatar" aria-hidden="true">YZ</div>
        <div>
          <h2 class="card-title">{site.author}</h2>
          <p class="about-role">本科在读 · 理工科</p>
        </div>
      </div>

      <div class="prose about-prose">
        <p>
          目前是个大二在读的理工科学生，人菜瘾大，看见什么技术都想上手摸两下，
          尤其是和代码沾边的东西 —— 这个站点本身就是一个例子。
        </p>
        <p>
          平时打打单机小游戏、刷刷视频听听歌。这个网站最早只是为了练手 Web，
          顺便给自己补上一个"个人主页"的空缺；后来发现它更适合当作学习资料的归档处，
          于是就一直放到现在。
        </p>
      </div>
    </section>

    <aside class="about-side">
      <section class="card" data-reveal>
        <h2 class="about-side-title">快问快答</h2>
        <dl class="fact-list">
          {
            facts.map((fact) => (
              <div class="fact">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="card" data-reveal>
        <h2 class="about-side-title">找到我</h2>
        <ul class="contact-list">
          {
            contact.map((item) => (
              <li>
                <span class="contact-label">{item.label}</span>
                <a
                  href={item.href}
                  target={item.href.startsWith('http') ? '_blank' : undefined}
                  rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {item.value}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </aside>
  </div>

  <section class="about-site" data-reveal>
    <h2 class="about-site-title">关于这个站点</h2>
    <div class="prose">
      <p>
        站点在 2026 年初重构过一次：从纯手写的 HTML/CSS/JS 迁到了 Astro，
        顺带重做了视觉与导航结构。旧版本的内容仍留在仓库的 git 历史里。
        技术栈是 Astro + 原生 CSS，没有任何前端框架运行时，
        构建产物就是一堆静态文件，直接挂在 GitHub Pages 上。
      </p>
      <p>
        内容以学习资料为主，也会放一些个人的项目记录。所有资料仅供学习交流使用。
      </p>
    </div>

    <div class="btn-row about-actions">
      <a class="btn" href={site.github} target="_blank" rel="noopener noreferrer">
        看看源码
      </a>
      <a class="btn" href="/notes/">站点更新日志</a>
    </div>
  </section>
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
  }

  .about-intro {
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }

  .about-identity {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-block-end: 1.5rem;
  }

  .about-avatar {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-lg);
    background: var(--gradient-text);
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  html[data-theme='dark'] .about-avatar {
    color: #04211d;
  }

  .about-role {
    color: var(--c-text-dim);
    font-size: 0.875rem;
  }

  .about-prose {
    max-width: 52ch;
  }

  .about-side {
    display: grid;
    gap: 1.25rem;
  }

  .about-side-title {
    margin-block-end: 1rem;
    font-size: 1rem;
  }

  .fact-list {
    display: grid;
    gap: 0.85rem;
  }

  .fact dt {
    color: var(--c-text-dim);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .fact dd {
    margin: 0;
    font-size: 0.9375rem;
  }

  .contact-list {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .contact-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .contact-label {
    color: var(--c-text-dim);
    font-size: 0.8125rem;
  }

  .contact-list a {
    font-size: 0.9375rem;
    word-break: break-all;
    text-align: end;
  }

  .about-site {
    margin-block-start: var(--section-gap);
    padding-block-start: 2.5rem;
    border-block-start: var(--border-hairline);
  }

  .about-site-title {
    margin-block-end: 1.25rem;
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
  }

  .about-actions {
    margin-block-start: 1.75rem;
  }
</style>
